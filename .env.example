# ==============================================================================
# 家庭庫存管理系統 (Home Inventory) 環境變數範例檔
# ==============================================================================

# [1. 資料庫連線設定 (PostgreSQL - Supabase / Local Docker)]
DATABASE_URL=postgresql://user:password@host:5432/postgres
DB_SCHEMA=home_inventory
DATABASE_URL_LOCAL=postgresql://postgres:postgres@localhost:5432/home_inventory

# [2. Cloudflare & 自訂網域]
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_ZONE_DOMAIN=advaz.au
CUSTOM_DOMAIN=homeinv.advaz.au

# [3. 雲端圖床 (Supabase Storage / Cloudflare R2)]
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=homeinventory
R2_PUBLIC_DOMAIN=https://pub-your-bucket.r2.dev

# [4. Google Cloud Run 部署設定]
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=australia-southeast1
CLOUD_RUN_SERVICE_NAME=home-inventory-backend

# [5. Google Gemini AI 向量搜尋]
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# [6. Google Play Console 設定]
PLAY_DEVELOPER_ID=8423547522607630996
PLAY_APP_ID=4974180872811830705
ANDROID_PACKAGE_NAME=com.freedom.homeinventory.home_inventory

# [7. 印表機]
BROTHER_PRINTER_NAME=BrotherLabelPtr
